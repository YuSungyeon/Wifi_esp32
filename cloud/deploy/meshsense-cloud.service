# /etc/systemd/system/meshsense-cloud.service
[Unit]
Description=MeshSense 집 상태 서비스 클라우드
After=network-online.target
Wants=network-online.target

[Service]
User=meshsense
WorkingDirectory=/opt/meshsense
# SOLAPI 키·발신 번호·세션 서명 키 — 저장소에 넣지 않는다 (cloud.env.example)
EnvironmentFile=/etc/meshsense/cloud.env
ExecStart=/opt/meshsense/.venv/bin/python cloud/server.py --host 127.0.0.1 --port 8000 \
    --db /var/lib/meshsense/home.db --base https://meshsense.cloud
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
